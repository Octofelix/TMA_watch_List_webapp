# Copy this file to .env and fill in what you need.

PORT=3000

# --- Phone notifications (Web Push) ---
# Keys that identify this app to phones' notification services. Generate a pair with:
#   npx web-push generate-vapid-keys
# Keep them the same forever: changing them means every device has to switch notifications on again.
# If left empty, the app makes a pair once and saves it in data/vapid.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address the notification services can reach if there's a problem.
VAPID_SUBJECT=mailto:you@example.com

# Live tracking: how often to check aircraft positions (seconds). Set TRACKING=off to disable.
TRACK_POLL_SECONDS=30
TRACKING=on

# Admin account, created on first start if it doesn't exist yet.
# Changing these later does nothing; change the admin password on the Profile page instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
